# Binance API (read-only key yeterli — paper trading)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# Telegram bot
# 1. @BotFather'dan bot oluştur, token al
# 2. Bot'a /start at, sonra https://api.telegram.org/bot<TOKEN>/getUpdates'ten chat_id'yi al
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Log
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# Paper trading
PAPER_INITIAL_EQUITY=10000.0
PAPER_RISK_PER_TRADE=0.01
PAPER_MAX_CONCURRENT_POSITIONS=2

# Database (SQLite path)
DB_PATH=data/kripto_bot.db
OHLCV_DATA_DIR=data/ohlcv
